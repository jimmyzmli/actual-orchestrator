# Actual Orchestrator (actual-orch) Configuration

# Actual Budget MCP Server Endpoint (Streamable HTTP)
ACTUAL_MCP_ENDPOINT=http://localhost:3000/mcp

# SQLite Cache Path (defaults to data/cache.sqlite)
# SQLITE_CACHE_PATH=data/cache.sqlite

# PocketBase Receipt Store (optional / if using PocketBase receipt archiving)
PB_UPLOAD_BASE_URL=http://localhost:8090
PB_USER=admin@example.com
PB_PASSWORD=your_pocketbase_password

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key

# Local Ollama Host (optional, defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Throttling & Peak Hours (set to 1 to allow requests during configured peak hours)
ALLOW_PEAK_HOURS=0
